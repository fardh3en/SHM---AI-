<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>SHM-AI Structural Inspection Report — {{ asset_name }}</title>
    <style>
        @page {
            size: A4;
            margin: 2cm 2.2cm;
            @bottom-center {
                content: "SHM-AI Structural Inspection Dossier  |  Page " counter(page) " of " counter(pages);
                font-family: Arial, Helvetica, sans-serif;
                font-size: 8pt;
                color: #6c757d;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10pt;
            color: #212529;
            line-height: 1.5;
            margin: 0;
            padding: 0;
        }

        /* ── Header ─────────────────────────────────────────────── */
        .report-header {
            background-color: #1e3a5f;
            color: #ffffff;
            padding: 18px 22px 14px 22px;
            margin-bottom: 18px;
            border-radius: 4px;
        }

        .report-header h1 {
            font-size: 18pt;
            margin: 0 0 4px 0;
            font-weight: bold;
            letter-spacing: 0.3px;
        }

        .report-header .subtitle {
            font-size: 9.5pt;
            color: #adb5bd;
            margin: 0 0 12px 0;
        }

        .report-header .meta-row {
            font-size: 8.5pt;
            color: #ced4da;
            border-top: 1px solid #2c5282;
            padding-top: 8px;
        }

        .report-header .meta-item {
            display: inline-block;
            margin-right: 20px;
        }

        /* ── Sections ────────────────────────────────────────────── */
        .section {
            margin-bottom: 18px;
            page-break-inside: avoid;
        }

        .section-title {
            font-size: 11pt;
            font-weight: bold;
            color: #1e3a5f;
            border-bottom: 2px solid #1e3a5f;
            padding-bottom: 4px;
            margin-bottom: 8px;
        }

        .section-body {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 12px 16px;
        }

        /* ── Health score ────────────────────────────────────────── */
        .health-score-container {
            display: flex;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 8px;
        }

        .health-score-label {
            font-size: 8.5pt;
            color: #6c757d;
            display: block;
            margin-bottom: 4px;
        }

        .health-score {
            font-size: 32pt;
            font-weight: bold;
            color: #1e3a5f;
            line-height: 1;
        }

        .health-score-unit {
            font-size: 11pt;
            color: #6c757d;
            vertical-align: super;
        }

        /* ── Badges ──────────────────────────────────────────────── */
        .risk-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 12px;
            font-size: 10pt;
            font-weight: bold;
            color: #ffffff;
            letter-spacing: 0.5px;
            vertical-align: middle;
            margin-left: 10px;
        }

        .action-badge {
            display: inline-block;
            padding: 5px 16px;
            border-radius: 4px;
            font-size: 12pt;
            font-weight: bold;
            color: #ffffff;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        /* ── Key-value rows ──────────────────────────────────────── */
        .info-row {
            margin-bottom: 5px;
            font-size: 9pt;
        }

        .info-label {
            color: #6c757d;
            display: inline-block;
            width: 220px;
            font-weight: 500;
        }

        .info-value {
            color: #212529;
            font-weight: bold;
        }

        /* ── Tables ──────────────────────────────────────────────── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 9pt;
            margin-top: 4px;
        }

        th {
            background-color: #1e3a5f;
            color: #ffffff;
            padding: 6px 10px;
            text-align: left;
            font-weight: 600;
        }

        td {
            padding: 6px 10px;
            border-bottom: 1px solid #dee2e6;
        }

        tr:nth-child(even) td {
            background-color: #f8f9fa;
        }

        /* ── Escalation trace ────────────────────────────────────── */
        .trace-block {
            background-color: #ffffff;
            border: 1px solid #ced4da;
            border-left: 4px solid #1e3a5f;
            padding: 8px 12px;
            margin-top: 8px;
            font-size: 8.5pt;
        }

        .trace-applied {
            color: #8e1414;
            font-weight: bold;
        }

        .trace-not-applied {
            color: #6c757d;
        }

        /* ── Cost range ──────────────────────────────────────────── */
        .cost-range {
            font-size: 16pt;
            font-weight: bold;
            color: #1e3a5f;
            margin: 4px 0;
        }

        .cost-basis {
            font-size: 8.5pt;
            color: #495057;
            margin-top: 4px;
        }

        .cost-disclaimer {
            font-size: 8pt;
            color: #6c757d;
            font-style: italic;
            margin-bottom: 4px;
        }

        /* ── Photographic Evidence ───────────────────────────────── */
        .evidence-image {
            max-width: 100%;
            max-height: 380px;
            object-fit: contain;
            border: 1px solid #ced4da;
            border-radius: 4px;
            display: block;
            margin: 6px auto 10px;
        }

        .bullet-list {
            margin: 4px 0 0 16px;
            padding: 0;
            font-size: 8.5pt;
            color: #495057;
        }

        .bullet-list li {
            margin-bottom: 3px;
        }

        /* ── Sign-off table ──────────────────────────────────────── */
        .signoff-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8.5pt;
            margin-top: 6px;
        }

        .signoff-table td {
            padding: 8px 10px;
            border: 1px solid #ced4da;
            vertical-align: top;
        }

        /* ── Footer ──────────────────────────────────────────────── */
        .report-footer {
            margin-top: 24px;
            padding-top: 8px;
            border-top: 1px solid #dee2e6;
            font-size: 7.5pt;
            color: #6c757d;
            line-height: 1.4;
        }
    </style>
</head>
<body>

<!-- ══════════════════════════ REPORT HEADER ══════════════════════════ -->
<div class="report-header">
    <h1>SHM-AI Structural Inspection Dossier</h1>
    <div class="subtitle">AI-Directed Predictive Maintenance &amp; Structural Health Monitoring</div>
    <div class="meta-row">
        <span class="meta-item"><strong>Asset:</strong> {{ asset_name }} ({{ asset_id[:8] }})</span>
        <span class="meta-item"><strong>Typology:</strong> {{ asset_type | upper }}</span>
        <span class="meta-item"><strong>Inspection ID:</strong> {{ inspection_id[:8] }}</span>
        <span class="meta-item"><strong>Assessed:</strong> {{ generated_at_utc }}</span>
    </div>
</div>

<!-- ══════════════════════════ EXECUTIVE SUMMARY / HEALTH SCORE ══════════════════════════ -->
<div class="section">
    <div class="section-title">Structural Health Score &amp; Risk Classification</div>
    <div class="section-body">
        <div class="health-score-container">
            <div>
                <span class="health-score-label">Deterministic Composite Health Score:</span>
                <span class="health-score">{{ health_score_formatted }}</span>
                <span class="health-score-unit">/ 100</span>
            </div>
            <div>
                <span class="risk-badge" style="background-color: {{ risk_level_color }};">
                    RISK: {{ risk_level | upper }}
                </span>
            </div>
        </div>
        <div class="info-row">
            <span class="info-label">Assessment Methodology:</span>
            <span class="info-value">{{ assessment_method }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Traceable Source Inspection:</span>
            <span class="info-value">{{ inspection_id }}</span>
        </div>
    </div>
</div>

<!-- ══════════════════════════ DEFECT SEVERITY BREAKDOWN ══════════════════════════ -->
<div class="section">
    <div class="section-title">Defect Severity &amp; Category Breakdown</div>
    {% if severity_breakdown %}
    <table>
        <thead>
            <tr>
                <th>Defect Category</th>
                <th>Observed Severity</th>
                <th style="text-align: right;">Count</th>
                <th style="text-align: right;">Total Area (mm²)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in severity_breakdown %}
            <tr>
                <td>{{ item.category | replace("_", " ") | title }}</td>
                <td>{{ item.severity | upper }}</td>
                <td style="text-align: right;">{{ item.observation_count }}</td>
                <td style="text-align: right;">{{ item.area_formatted or "—" }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="section-body">Zero structural defect observations recorded in this inspection session.</div>
    {% endif %}
</div>

<!-- ══════════════════════════ STRUCTURAL FAILURE MODES ══════════════════════════ -->
<div class="section">
    <div class="section-title">Inferred Structural Failure Mechanisms (Rules Engine)</div>
    {% if failure_modes %}
    <table>
        <thead>
            <tr>
                <th>Failure Mechanism</th>
                <th style="text-align: center;">Confidence</th>
                <th>Engineering Mechanism Diagnosis</th>
            </tr>
        </thead>
        <tbody>
            {% for mode in failure_modes %}
            <tr>
                <td>{{ mode.category | replace("_", " ") | title }}</td>
                <td style="text-align: center;">{{ mode.confidence_pct }}</td>
                <td>{{ mode.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="section-body">No critical failure modes triggered based on recorded defect morphology.</div>
    {% endif %}
</div>

<!-- ══════════════════════════ MAINTENANCE RECOMMENDATION ══════════════════════════ -->
<div class="section">
    <div class="section-title">Maintenance Decision &amp; Action Timeline</div>
    <div class="section-body">
        <div>
            <span class="action-badge" style="background-color: {{ action_color }};">
                RECOMMENDED ACTION: {{ recommended_action | replace("_", " ") | upper }}
            </span>
        </div>
        <div class="info-row">
            <span class="info-label">Recommended Re-Inspection Interval:</span>
            <span class="info-value">{{ next_inspection_formatted }} years</span>
        </div>

        <div class="trace-block">
            <strong>Decision Escalation Audit Trace</strong>
            <div class="info-row" style="margin-top: 5px;">
                <span class="info-label">Baseline action (from risk level):</span>
                <span class="info-value">{{ baseline_action | replace("_", " ") | upper }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Failure-mode escalation:</span>
                {% if failure_mode_escalation_applied %}
                <span class="trace-applied">APPLIED — triggering: {{ triggering_failure_modes | join(", ") | replace("_", " ") | upper }}</span>
                {% else %}
                <span class="trace-not-applied">not applied</span>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════ ESTIMATED COST ══════════════════════════ -->
<div class="section">
    <div class="section-title">Indicative Maintenance Budget Estimate</div>
    <div class="section-body">
        <div class="cost-disclaimer">Indicative budgetary range only — requires quantity surveying verification prior to procurement.</div>
        <div class="cost-range">{{ cost_currency }}&nbsp;{{ cost_low_formatted }}&nbsp;–&nbsp;{{ cost_high_formatted }}</div>
        <div class="cost-basis"><strong>Parametric Basis:</strong> {{ cost_basis }}</div>
    </div>
</div>

{% if has_degradation %}
<!-- ══════════════════════════ MATERIAL DEGRADATION (COMPATIBILITY) ══════════════════════════ -->
<div class="section">
    <div class="section-title">Material Degradation Assessment (Phase 4)</div>
    <div class="section-body">
        <div class="info-row">
            <span class="info-label">Carbonation Depth:</span>
            <span class="info-value">{{ degradation.carbonation_depth_formatted }} mm</span>
        </div>
        <div class="info-row">
            <span class="info-label">Time to Depassivation:</span>
            <span class="info-value">{{ degradation.time_to_depassivation }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Corrosion Initiated:</span>
            <span class="info-value">{% if degradation.corrosion_initiated %}Yes{% else %}No{% endif %}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Corrosion Index (0–1):</span>
            <span class="info-value">{{ degradation.corrosion_index_formatted }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Maintenance Required:</span>
            {% if degradation.requires_maintenance %}
            <span class="flag-yes">YES</span>
            {% else %}
            <span class="flag-no">NO</span>
            {% endif %}
        </div>
    </div>
</div>
{% else %}
<div class="placeholder" style="display: none;">
    <div class="placeholder-title">No Phase 4 Degradation Assessment Available</div>
</div>
{% endif %}

<!-- ══════════════════════════ PHOTOGRAPHIC EVIDENCE & DEFECT GALLERY ══════════════════════════ -->
<div class="section">
    <div class="section-title">Photographic Inspection Evidence &amp; Detections</div>
    <div class="section-body">
        {% if input_image_path %}
        <div style="text-align: center;">
            <img src="{{ input_image_path }}" alt="Inspection Evidence" class="evidence-image" />
            <div style="font-size: 8pt; color: #6c757d; margin-bottom: 8px;">Source: {{ input_image_path }}</div>
        </div>
        {% endif %}

        {% if detections %}
        <table>
            <thead>
                <tr>
                    <th>Ref #</th>
                    <th>Classification</th>
                    <th style="text-align: center;">Confidence</th>
                    <th style="text-align: right;">Area (px²)</th>
                    <th style="text-align: right;">Length (px)</th>
                    <th style="text-align: right;">Width (px)</th>
                </tr>
            </thead>
            <tbody>
                {% for det in detections %}
                <tr>
                    <td>#{{ loop.index }}</td>
                    <td>{{ det.defect_type | replace("_", " ") | title }}</td>
                    <td style="text-align: center;">{{ "%.1f" | format(det.confidence * 100) }}%</td>
                    <td style="text-align: right;">{{ det.area_px or "—" }}</td>
                    <td style="text-align: right;">{{ det.length_px or "—" }}</td>
                    <td style="text-align: right;">{{ det.width_px or "—" }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div style="font-size: 8.5pt; color: #6c757d;">Zero defect detections recorded on this inspection media.</div>
        {% endif %}
    </div>
</div>

<!-- ══════════════════════════ METHODOLOGY & GOVERNANCE ══════════════════════════ -->
<div class="section">
    <div class="section-title">Engineering Methodology &amp; Disclosures</div>
    <div class="section-body" style="font-size: 8.5pt;">
        <div class="info-row">
            <span class="info-label">Data Sources:</span>
            <ul class="bullet-list">
                {% for src in data_sources %}
                <li>{{ src }}</li>
                {% endfor %}
            </ul>
        </div>
        <div class="info-row" style="margin-top: 6px;">
            <span class="info-label">Engineering Assumptions:</span>
            <ul class="bullet-list">
                {% for item in assumptions %}
                <li>{{ item }}</li>
                {% endfor %}
            </ul>
        </div>
        <div class="info-row" style="margin-top: 6px;">
            <span class="info-label">Structural Limitations:</span>
            <ul class="bullet-list">
                {% for item in limitations %}
                <li>{{ item }}</li>
                {% endfor %}
            </ul>
        </div>
        {% if missing_inputs %}
        <div class="info-row" style="margin-top: 6px;">
            <span class="info-label">Missing / Uncalibrated Data:</span>
            <ul class="bullet-list">
                {% for item in missing_inputs %}
                <li style="color: #b7410e;">{{ item }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</div>

<!-- ══════════════════════════ PROFESSIONAL SIGN-OFF ══════════════════════════ -->
<div class="section">
    <div class="section-title">Professional Structural Engineer Sign-Off</div>
    <div class="section-body">
        <table class="signoff-table">
            <tr>
                <td style="width: 50%;">
                    <strong>Reviewing Engineer Name:</strong><br />
                    <span style="display: block; margin-top: 14px; border-bottom: 1px dotted #999;">&nbsp;</span>
                </td>
                <td style="width: 50%;">
                    <strong>Professional License / Registration #:</strong><br />
                    <span style="display: block; margin-top: 14px; border-bottom: 1px dotted #999;">&nbsp;</span>
                </td>
            </tr>
            <tr>
                <td>
                    <strong>Formal Decision:</strong><br />
                    <label style="margin-right: 15px;">&#9633; Approved</label>
                    <label style="margin-right: 15px;">&#9633; Approved with Modifications</label>
                    <label>&#9633; Rejected</label>
                </td>
                <td>
                    <strong>Signature &amp; Date:</strong><br />
                    <span style="display: block; margin-top: 14px; border-bottom: 1px dotted #999;">&nbsp;</span>
                </td>
            </tr>
        </table>
    </div>
</div>

<!-- ══════════════════════════ REPORT METADATA ══════════════════════════ -->
<div class="section">
    <div class="section-title">Dossier Provenance Metadata</div>
    <div class="section-body" style="font-size: 8pt; color: #495057;">
        <div class="info-row">
            <span class="info-label">Service Version:</span>
            <span class="info-value">{{ service_version }}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Dossier Generator Version:</span>
            <span class="info-value">{{ generator_version }}</span>
        </div>
        {% if engine_versions %}
        <div class="info-row">
            <span class="info-label">Sub-Engine Modules:</span>
            <span class="info-value">
                {%- for name, ver in engine_versions.items() %}{{ name }}: {{ ver }}{% if not loop.last %}; {% endif %}{% endfor -%}
            </span>
        </div>
        {% endif %}
        <div class="info-row">
            <span class="info-label">Compiled Timestamp (UTC):</span>
            <span class="info-value">{{ generated_at_utc }}</span>
        </div>
    </div>
</div>

<!-- ══════════════════════════ LEGAL DISCLAIMER ══════════════════════════ -->
<div class="report-footer">
    <strong>STATUTORY ENGINEERING NOTICE:</strong>
    This document is generated by an automated structural health monitoring intelligence platform.
    Defect telemetry, severity classifications, and intervention recommendations are indicative preliminary findings.
    Prior to initiating remedial intervention, structural shoring, or budgetary commitment, all findings must be reviewed
    and formally validated on-site by a licensed structural engineer (PE / CEng MIStructE).
</div>

</body>
</html>
