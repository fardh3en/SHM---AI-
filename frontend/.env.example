# SHM-AI Frontend — Environment Configuration
# Copy this file to .env.local or set these variables in your deployment dashboard (e.g. Vercel).

# Production backend API base URL
# Local development: leave empty to route through the Vite proxy (/api -> http://localhost:8000)
# Production / Vercel: set to https://infralytiq.onrender.com
VITE_API_BASE_URL=https://infralytiq.onrender.com
